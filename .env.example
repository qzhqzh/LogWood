NODE_ENV="production"

# Required by Docker Compose. Values must differ and contain at least 32
# alphanumeric characters because Compose builds connection URLs from them.
# Generate each value independently, for example: openssl rand -hex 32
# Existing deployments must run scripts/upgrade-db-credentials.sh before the
# first `docker compose up` with new values; changing env alone does not rotate
# credentials inside an existing PostgreSQL data directory.
POSTGRES_ADMIN_PASSWORD=""
POSTGRES_APP_PASSWORD=""
POSTGRES_ADMIN_USER="postgres"
POSTGRES_APP_USER="logwood_app"
POSTGRES_DB="logwood"
# Loopback-only PostgreSQL port used by the host-network reply worker.
POSTGRES_HOST_PORT="15432"
# Optional for commands run directly on the host. Web and worker Compose
# services receive a non-superuser application DATABASE_URL automatically.
DATABASE_URL="postgresql://logwood_app:<POSTGRES_APP_PASSWORD>@localhost:15432/logwood?schema=public"

# Local Docker Compose traffic enters through Nginx at http://localhost:10000.
# NEXTAUTH_URL="https://logwood.example.com"
# Required: NextAuth session encryption key. Must be at least 32 chars and
# unique per environment. Generate one with: openssl rand -base64 32
# DO NOT use a placeholder string in production - the app will refuse to boot.
NEXTAUTH_SECRET=""

# Optional: public site URL used for metadataBase, canonical, sitemap, og:url. Falls back to NEXTAUTH_URL.
# SITE_URL="https://logwood.example.com"

# Optional: Google Search Console verification token.
# GOOGLE_SITE_VERIFICATION=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- DeepSeek idea distillation (server-only) ---

DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_IDEA_MODEL="deepseek-v4-pro"
DEEPSEEK_FORGE_MODEL="deepseek-v4-pro"
# Stable provider/model snapshot label shown in public AI attribution.
DEEPSEEK_FORGE_MODEL_VERSION="deepseek-v4-pro"
# Optional comma-separated allowlist for the read-only Prompt Workbench runner.
# Blank falls back to DEEPSEEK_FORGE_MODEL.
DEEPSEEK_WORKBENCH_MODELS=""
DEEPSEEK_WORKBENCH_MODEL_VERSION=""

# --- CPA image generation (server-only) ---

# The Web container reads only api-keys[0] from this read-only CPA config mount.
# Do not copy the key into source files, browser variables, or the database.
CPA_CONFIG_FILE_HOST="/data/03_serve/cpa/config.yaml"
CPA_BASE_URL="http://192.168.124.2:31000/v1"
# Plain HTTP is refused unless the exact host is listed here. Prefer HTTPS for
# remote CPA deployments.
CPA_HTTP_ALLOWED_HOSTS="192.168.124.2"
CPA_IMAGE_MODELS="gemini-3.1-flash-image"
CPA_IMAGE_MODEL_VERSION="gemini-3.1-flash-image"
# Optional alternative to the read-only config mount. Never commit a real key.
CPA_API_KEY=""

# --- MCP agent entry (server-only) ---

# Bearer token for /api/mcp. Required when MCP is enabled; use at least 32
# random characters, e.g. `openssl rand -base64 32`.
LOGWOOD_MCP_API_KEY=""
# Site user that owns all records created through MCP. The user row is created
# on first authenticated MCP request when it does not exist.
LOGWOOD_MCP_USER_EMAIL=""
# Stable identity bound to the legacy single-token credential. A different
# X-LogWood-Agent-Id is rejected instead of being trusted.
LOGWOOD_MCP_AGENT_ID="codex"
# Preferred multi-agent form. Store SHA-256 token digests, never raw tokens.
# Example: [{"tokenSha256":"<64 hex>","email":"agent@example.com","agentId":"codex"}]
LOGWOOD_MCP_CREDENTIALS_JSON=""

# --- Agent reply coordinator (server-only) ---

# The `agent-reply` Compose profile uses host network so it can reach Totemora's
# loopback-only gateway without exposing that gateway publicly.
TOTEMORA_GATEWAY_URL="http://127.0.0.1:4310"
TOTEMORA_OPERATOR_TOKEN=""
# Optional stable ID for one worker process. Leave empty to generate a
# non-identifying process lease ID at startup.
LOGWOOD_REPLY_WORKER_ID=""
# Database-only polling interval. Empty polls never invoke a model.
LOGWOOD_REPLY_POLL_MS="60000"
LOGWOOD_REPLY_BATCH_SIZE="3"

# Optional: fallback admin sign-in when OAuth providers are unavailable.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Prefer hash in production; if set, login checks password via bcrypt compare.
ADMIN_PASSWORD_HASH=""

# --- Security ---

# Set to "true" only when the app is behind a reverse proxy (nginx, cloud LB)
# that you trust to set X-Forwarded-For / X-Real-IP correctly. When false (the
# default) the app refuses to read those headers, preventing client IP spoofing.
LOGWOOD_TRUST_PROXY="true"

# HMAC key used to hash client IPs into rate-limit actor keys. Without this,
# the app falls back to plain SHA-256 and warns on boot in production. Generate
# with: openssl rand -base64 32
LOGWOOD_IP_HASH_SECRET=""
